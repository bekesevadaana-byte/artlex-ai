function words(text) {

return text
.trim()
.split(/\s+/)
.filter(Boolean);

}



function countType(arr, list) {

return arr.filter(word =>

list.some(key =>
word.toLowerCase().includes(key)
)

).length;

}



function tags(arr, list) {

let found = [];

arr.forEach(word => {

let clean =
word
.toLowerCase()
.replace(/[.,!?;:"()]/g, "");

if (
list.some(key => clean.includes(key))
&&
!found.includes(clean)
) {

found.push(clean);

}

});

if (found.length === 0) {

return "<span class='tag'>характерных слов не обнаружено</span>";

}

return found
.slice(0, 15)
.map(word => `<span class="tag">${word}</span>`)
.join("");

}



