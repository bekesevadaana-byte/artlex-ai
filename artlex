function loadPainting() {

const key =
document.getElementById("painting").value;

const painting =
paintings[key];

document.getElementById("paintingImage").src =
painting.image;

document.getElementById("paintingCaption").textContent =
painting.title;

document.getElementById("humanDescription").value =
painting.human;

document.getElementById("aiDescription").value =
painting.ai;

document.getElementById("customDescription").value =
"";

document.getElementById("result").style.display =
"none";

}



/* =========================================================
   АНАЛИЗ
========================================================= */

function analyze() {

const custom =
document
.getElementById("customDescription")
.value
.trim();


const humanText =
custom ||
document
.getElementById("humanDescription")
.value;


const aiText =
document
.getElementById("aiDescription")
.value;


const humanWords =
words(humanText);

const aiWords =
words(aiText);


const emotionCount =
countType(
humanWords,
emotions
);


const factCount =
countType(
aiWords,
facts
);


document.getElementById("humanWords").textContent =
humanWords.length;


document.getElementById("aiWords").textContent =
aiWords.length;


document.getElementById("humanEmotion").textContent =
Math.round(
emotionCount /
Math.max(humanWords.length, 1)
* 100
)
+ "%";


document.getElementById("aiFacts").textContent =
Math.round(
factCount /
Math.max(aiWords.length, 1)
* 100
)
+ "%";


document.getElementById("humanTags").innerHTML =
tags(
humanWords,
emotions
);


document.getElementById("aiTags").innerHTML =
tags(
aiWords,
facts
);


const conclusion =
document.getElementById("conclusion");


if (custom) {

conclusion.textContent =
"Сравнение выполнено между вашим собственным описанием и текстом ИИ. Результат показывает особенности именно этих двух текстов. Для научного вывода необходимо повторить эксперимент на нескольких картинах.";

}

else {

conclusion.textContent =
"Сравнение выполнено между эталонным человеческим описанием и описанием ИИ. В данном примере человеческий текст ориентирован на эмоциональную интерпретацию, а описание ИИ — на наблюдаемые визуальные признаки. Это гипотеза исследования, поэтому окончательный вывод следует делать по всему корпусу картин.";

}


document.getElementById("result").style.display =
"block";

}



